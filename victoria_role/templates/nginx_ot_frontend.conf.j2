# Ansible Managed: OT-Microservices Reverse Proxy Configuration
server {
    listen {{ nginx_port }};
    server_name {{ server_name }};

    location / {
        root {{ frontend_build_path }};
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /employee/ {
        proxy_pass http://{{ employee_api_host }}:{{ employee_api_port }}/api/v1/employee/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /salary/ {
        proxy_pass http://{{ salary_api_host }}:{{ salary_api_port }}/api/v1/salary/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /attendance/ {
        proxy_pass http://{{ attendance_api_host }}:{{ attendance_api_port }}/api/v1/attendance/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
